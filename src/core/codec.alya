## cache Scalar Codec (float encode/decode)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Fixed-point float codec shared by the typed setters/getters and the
## file snapshot format. Always compiled (no feature gate).

import "std/str"
import "std/math"

# Left-pads an integer with zeros to 6 digits.
function pad6(n: int) -> string
    let s = str(n)
    while len(s) < 6
        s = "0" + s
    end
    return s
end

## Encodes a float with fixed 6-decimal precision (e.g. `"-3.500000"`).
##
## NOTE: Manual codec on purpose: `str()` on float values prints raw bits
## on some builds, so floats never go through `str()` here. Precision is
## 6 decimals; very large magnitudes may lose exactness.
pub function snapshot_encode_float(v: float) -> string
    let neg = false
    let a = v
    if a < 0.0
        neg = true
        a = 0.0 - a
    end
    let whole = floor(a)
    let frac = round((a - whole) * 1000000.0)
    if frac >= 1000000
        whole = whole + 1
        frac = 0
    end
    let out = str(whole) + "." + pad6(frac)
    if neg == true
        out = "-" + out
    end
    return out
end

## Decodes a string produced by `snapshot_encode_float`.
pub function snapshot_decode_float(s: string) -> float
    let t = s
    let neg = 1.0
    if len(t) > 0 and t[..1] == "-"
        neg = 0.0 - 1.0
        t = t[1..]
    end
    let dot = index_of(t, ".")
    if dot < 0
        return neg * to_int(t)
    end
    let whole = to_int(t[..dot])
    let frac = to_int(t[(dot + 1)..])
    return neg * (whole + frac / 1000000.0)
end
