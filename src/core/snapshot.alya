## cache Snapshot Serialization (save/load)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Line-based snapshot format for scalar values (string/int/float/bool).
## Compiled only with the `snapshot` feature (default-on); the scalar
## codec lives in `./codec.alya` and is always available.
##
## ```text
## alyacache\tv1
## <escaped key>\t<kind>\t<ttl seconds>\t<escaped value>
## ```
##
## - `kind` is `s` (string), `i` (int), `f` (float), or `b` (bool as 1/0).
##   Other value types (arrays, maps) are skipped on save.
## - `ttl` is remaining seconds, rounded up (`0` = persist). Already-expired
##   entries are skipped on save; malformed lines are skipped on load.
## - Keys and values escape `\`, tab, newline, and carriage return.

import "std/str"
import "../types.alya"

## Format header line identifying snapshot files.
pub function snapshot_header() -> string
    return "alyacache\tv1"
end

## Escapes `\`, tab, newline, and carriage return in `s`.
pub function snapshot_escape(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    while i < n
        let ch = char_at(s, i)
        when ch
            is "\\" then out += "\\\\"
            is "\t" then out += "\\t"
            is "\n" then out += "\\n"
            is "\r" then out += "\\r"
            else out += ch
        end
        i += 1
    end
    return out
end

## Reverses `snapshot_escape`.
pub function snapshot_unescape(s: string) -> string
    let out = ""
    let i = 0
    let n = len(s)
    let esc = false
    while i < n
        let ch = char_at(s, i)
        if esc == true
            when ch
                is "n" then out += "\n"
                is "t" then out += "\t"
                is "r" then out += "\r"
                is "\\" then out += "\\"
                else out += ch
            end
            esc = false
        else
            if ch == "\\"
                esc = true
            else
                out += ch
            end
        end
        i += 1
    end
    return out
end

## Serializes one entry into a snapshot line, or "" when skipped.
##
## Only entries written via the typed setters (`set_str`/`set_int`/
## `set_float`/`set_bool` and the `set_many_*` batch variants) carry a kind
## tag and are persisted; generic `set`/`set_many` values and already-expired
## entries are skipped. (Runtime type detection via `is` is unreliable for
## dynamic values on some builds, so the kind is recorded at write time.)
##
## NOTE: Loop-free leaf (single entry, no iteration). Called once per key
## from the save loop in the lib facade.
pub function snapshot_line(c: Cache, key) -> string
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            let kind = meta.kind
            if kind == "s" or kind == "i" or kind == "f" or kind == "b"
                # "f" values are already fixed-point strings (see set_float).
                let repr = str(c.store[key])
                if meta.expires_at != 0
                    let ms_left = meta.expires_at - clock_ms()
                    if ms_left <= 0
                        return ""
                    end
                    let ttl_left = (ms_left + 999) / 1000
                    return snapshot_escape(key) + "\t" + kind + "\t" + str(ttl_left) + "\t" + snapshot_escape(repr)
                end
                return snapshot_escape(key) + "\t" + kind + "\t0\t" + snapshot_escape(repr)
            end
        end
    end
    return ""
end

## Parses a snapshot line into `[key, value, ttl, kind]` or null when malformed.
##
## `"f"` values stay in fixed-point string form (decoded lazily on read);
## `"i"` values are converted with `to_int` eagerly; `"b"` values are
## normalized to `1`/`0` with the `"b"` tag.
##
## NOTE: Plain sequential `if`s on purpose: `when` value patterns on
## dynamic strings miscompile on some builds. `==` is reliable.
pub function snapshot_parse(line: string)
    let parts = split(line, "\t")
    if len(parts) != 4
        return null
    end
    let key = snapshot_unescape(parts[0])
    let kind = parts[1]
    let ttl = to_int(parts[2])
    let raw = snapshot_unescape(parts[3])
    if kind == "s"
        return [key, raw, ttl, "s"]
    end
    if kind == "i"
        return [key, to_int(raw), ttl, "i"]
    end
    if kind == "f"
        # Already fixed-point form; stored as-is with the "f" tag.
        return [key, raw, ttl, "f"]
    end
    if kind == "b"
        if to_int(raw) == 0
            return [key, 0, ttl, "b"]
        end
        return [key, 1, ttl, "b"]
    end
    return null
end
