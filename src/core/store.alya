## cache Core Storage Engine
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Implements set/get/delete with TTL expiry plus LRU/FIFO capacity eviction.
##
## Storage layout: user values live directly in the `store` map (maps
## handle mixed `any` values correctly), while expiry and hit counters
## live as typed `CacheMeta` structs in the parallel `meta` map.

import "../types.alya"
import "./snapshot.alya"

# ───────────────────────────────────────────────────────────────
# Private Helpers
# ───────────────────────────────────────────────────────────────

# Resolves effective TTL: negative `ttl` falls back to cache default.
function resolve_ttl(ttl: int, default_ttl: int) -> int
    if ttl < 0
        return default_ttl
    end
    return ttl
end

# Converts a TTL into an absolute expiry epoch (`0` = never expires).
function expiry_for(ttl: int) -> int
    if ttl <= 0
        return 0
    end
    return time() + ttl
end

# Returns 1 when `meta` is expired right now, 0 otherwise.
function meta_expired(meta: CacheMeta) -> int
    if meta.expires_at == 0
        return 0
    end
    if time() >= meta.expires_at
        return 1
    end
    return 0
end

# Removes all occurrences of `key` from the order array (in place).
function detach_key(c: Cache, key)
    let kept = []
    for k in c.order
        if k != key
            kept.push(k)
        end
    end
    c.order = kept
end

# Moves `key` to the back of the order array (most-recently-used).
function touch_key(c: Cache, key)
    detach_key(c, key)
    c.order.push(key)
end

# Fires the eviction hook when one is registered. Reads are single-shot
# (no loop here); callers pass already-sanitized keys and live values.
function fire_evict(c: Cache, key, value)
    if c.evict_hook is not null
        let cb = c.evict_hook
        cb(key, value)
    end
end

# Fires the expiry hook when one is registered.
function fire_expire(c: Cache, key, value)
    if c.expire_hook is not null
        let cb = c.expire_hook
        cb(key, value)
    end
end

# Evicts a single entry when capacity is reached. Returns 1 if evicted.
function evict_one(c: Cache) -> int
    if c.capacity <= 0
        return 0
    end
    if c.policy == EvictionPolicy.None
        return 0
    end
    if len(c.store) < c.capacity
        return 0
    end
    if len(c.order) == 0
        return 0
    end
    if c.policy == EvictionPolicy.LFU
        return evict_lfu(c)
    end
    let victim = "" + c.order[0]
    return evict_key(c, victim)
end

# Removes exactly `victim` from both maps and order. Returns 1 if removed.
function evict_key(c: Cache, victim) -> int
    let value = null
    if victim in c.store
        value = c.store[victim]
        c.store.remove(victim)
    else
        return 0
    end
    if victim in c.meta
        c.meta.remove(victim)
    end
    detach_key(c, victim)
    c.evictions += 1
    fire_evict(c, victim, value)
    return 1
end

# Evicts the least-frequently-used key (ties break by age, oldest first).
#
# NOTE: Index-based `while` loop with sanitized keys and direct reads,
# no helper calls inside the body (same discipline as `evict_one`).
function evict_lfu(c: Cache) -> int
    let best = ""
    let best_hits = -1
    let n = len(c.order)
    let i = 0
    while i < n
        let key = "" + c.order[i]
        if key in c.meta
            let meta = c.meta[key]
            if best_hits < 0 or meta.entry_hits < best_hits
                best_hits = meta.entry_hits
                best = key
            end
        elif key in c.store
            if best_hits < 0 or 0 < best_hits
                best_hits = 0
                best = key
            end
        end
        i += 1
    end
    if best == ""
        return 0
    end
    return evict_key(c, best)
end

# Removes the entry for `key` from both maps and order. Returns 1 if removed.
function drop_key(c: Cache, key) -> int
    let existed = 0
    if key in c.store
        existed = 1
        c.store.remove(key)
    end
    if key in c.meta
        c.meta.remove(key)
    end
    detach_key(c, key)
    return existed
end

# ───────────────────────────────────────────────────────────────
# Public Core Functions
# ───────────────────────────────────────────────────────────────

## Inserts or overwrites `key` with `value` and an optional TTL.
##
## ### Parameters
## - `c`: Target `Cache` instance (mutated in place).
## - `key`: Entry key string.
## - `value`: Payload to store (any type, stored directly in the map).
## - `ttl`: TTL seconds (`< 0` uses cache default, `0` = never expires).
##
## ### Returns
## `1` on success.
pub function store_set(c: Cache, key, value, ttl: int = -1, kind: string = "") -> int
    let effective = resolve_ttl(ttl, c.default_ttl)
    let now = time()
    let expires = expiry_for(effective)
    let exists = key in c.store ? 1 : 0

    if exists == 0
        evict_one(c)
    else
        detach_key(c, key)
    end

    c.store[key] = value
    c.meta[key] = CacheMeta {
        expires_at: expires,
        inserted_at: now,
        entry_hits: 0,
        kind: kind
    }
    c.order.push(key)
    return 1
end

## Reads `key`, returning the stored value or null on miss/expiry.
##
## Live reads increment hit counters (and refresh LRU recency).
## Expired entries are removed eagerly and count as misses.
pub function store_get(c: Cache, key)
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            if meta_expired(meta) == 1
                let gone = c.store[key]
                drop_key(c, key)
                c.misses += 1
                fire_expire(c, key, gone)
                return null
            end
            meta.entry_hits += 1
            c.meta[key] = meta
        end
        c.hits += 1
        if c.policy == EvictionPolicy.LRU
            touch_key(c, key)
        end
        return c.store[key]
    end
    c.misses += 1
    return null
end

## Reads `key` as a float written via `set_float`.
##
## Returns the decoded float value, or null on miss/expiry/wrong kind.
## Plain `get` on `"f"` entries returns the fixed-point string form;
## use this function for numeric comparison and arithmetic.
pub function store_get_float(c: Cache, key)
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            if meta_expired(meta) == 1
                let gone = c.store[key]
                drop_key(c, key)
                c.misses += 1
                fire_expire(c, key, gone)
                return null
            end
            if meta.kind != "f"
                c.misses += 1
                return null
            end
            meta.entry_hits += 1
            c.meta[key] = meta
            c.hits += 1
            if c.policy == EvictionPolicy.LRU
                touch_key(c, key)
            end
            return snapshot_decode_float(c.store[key])
        end
        return null
    end
    c.misses += 1
    return null
end

## Reads `key`, returning `fallback` instead of null on miss/expiry.
pub function store_get_or(c: Cache, key, fallback)
    let val = store_get(c, key)
    if val is null
        return fallback
    end
    return val
end

## Returns 1 when `key` exists and is live, 0 otherwise.
##
## Expired entries are removed eagerly and reported as absent.
pub function store_has(c: Cache, key) -> int
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            if meta_expired(meta) == 1
                let gone = c.store[key]
                drop_key(c, key)
                c.misses += 1
                fire_expire(c, key, gone)
                return 0
            end
        end
        return 1
    end
    return 0
end

## Deletes `key` from the cache. Returns 1 if an entry was removed.
pub function store_delete(c: Cache, key) -> int
    return drop_key(c, key)
end

## Removes all entries and resets hit/miss/eviction counters.
pub function store_clear(c: Cache)
    c.store = map()
    c.meta = map()
    c.order = []
    c.hits = 0
    c.misses = 0
    c.evictions = 0
end

## Returns the number of entries currently held (including unpruned expired).
pub function store_size(c: Cache) -> int
    return len(c.store)
end

# Checks one key for expiry and drops it when expired.
#
# NOTE: Loop-free leaf on purpose. It is called once per key from the
# iteration loop in `Cache.prune` (lib facade), keeping struct-map reads
# out of any loop body inside this module.
pub function prune_key(c: Cache, key) -> int
    if key in c.meta
        let meta = c.meta[key]
        if meta.expires_at != 0 and time() >= meta.expires_at
            let gone = null
            if key in c.store
                gone = c.store[key]
                c.store.remove(key)
            end
            c.meta.remove(key)
            fire_expire(c, key, gone)
            return 1
        end
    end
    return 0
end

## Returns an independent snapshot copy of the recency/insertion order.
##
## NOTE: Single slice operation, no loop. Lets callers iterate a local
## array instead of struct fields.
pub function store_order_snapshot(c: Cache) -> array
    return c.order[..]
end

## Replaces the recency/insertion order array.
pub function store_set_order(c: Cache, order: array)
    c.order = order
end

## Returns remaining TTL seconds for `key` (`-1` when missing/expired).
##
## A live entry with no expiry reports `0` (never expires).
pub function store_ttl(c: Cache, key) -> int
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            if meta_expired(meta) == 1
                let gone = c.store[key]
                drop_key(c, key)
                c.misses += 1
                fire_expire(c, key, gone)
                return -1
            end
            if meta.expires_at == 0
                return 0
            end
            let left = meta.expires_at - time()
            if left < 0
                return 0
            end
            return left
        end
        return 0
    end
    return -1
end

## Refreshes the TTL of a live entry. Returns 1 on success, 0 if missing.
##
## ### Parameters
## - `c`: Target `Cache` instance.
## - `key`: Entry key string.
## - `ttl`: New TTL seconds (`0` = persist, `< 0` uses cache default).
pub function store_expire(c: Cache, key, ttl: int) -> int
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            if meta_expired(meta) == 1
                let gone = c.store[key]
                drop_key(c, key)
                c.misses += 1
                fire_expire(c, key, gone)
                return 0
            end
            let effective = resolve_ttl(ttl, c.default_ttl)
            meta.expires_at = expiry_for(effective)
            c.meta[key] = meta
            return 1
        end
        return 1
    end
    return 0
end

## Reads `key` without affecting recency or counters.
##
## Returns the stored value, or null when missing/expired. Expired entries
## are still removed eagerly (lazy cleanup), but no hit/miss is recorded
## and LRU recency is left untouched.
pub function store_peek(c: Cache, key)
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            if meta_expired(meta) == 1
                let gone = c.store[key]
                drop_key(c, key)
                fire_expire(c, key, gone)
                return null
            end
        end
        return c.store[key]
    end
    return null
end

## Refreshes recency (and optionally TTL) without changing the value.
##
## Returns 1 when `key` is live, 0 when missing/expired. Never touches
## hit/miss counters. `ttl = -1` keeps the current expiry, `ttl = 0`
## persists the entry, `ttl > 0` sets a fresh TTL from now.
pub function store_touch(c: Cache, key, ttl: int = -1) -> int
    if key in c.store
        if key in c.meta
            let meta = c.meta[key]
            if meta_expired(meta) == 1
                let gone = c.store[key]
                drop_key(c, key)
                c.misses += 1
                fire_expire(c, key, gone)
                return 0
            end
            if ttl >= 0
                meta.expires_at = expiry_for(ttl)
                c.meta[key] = meta
            end
        end
        if c.policy == EvictionPolicy.LRU
            touch_key(c, key)
        end
        return 1
    end
    return 0
end

## Updates the capacity, evicting excess entries when shrinking.
##
## `capacity <= 0` means unbounded (no eviction is performed).
pub function store_set_capacity(c: Cache, capacity: int)
    c.capacity = capacity
    if capacity <= 0
        return
    end
    let budget = len(c.store) + 8
    while len(c.store) > capacity and budget > 0
        budget = budget - 1
        if c.policy == EvictionPolicy.None
            if len(c.order) == 0
                break
            end
            drop_key(c, "" + c.order[0])
        else
            if evict_one(c) == 0
                break
            end
        end
    end
end

## Updates the default TTL applied when `set` omits `ttl`.
##
## Negative values are normalized to `0` (never expires).
pub function store_set_default_ttl(c: Cache, default_ttl: int)
    if default_ttl < 0
        c.default_ttl = 0
    else
        c.default_ttl = default_ttl
    end
end
