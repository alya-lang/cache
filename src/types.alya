## cache Types & Data Structures
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Defines eviction policies, options, entries, cache container, and statistics
## for a high-performance in-memory cache with LRU/FIFO eviction and TTL expiry.

# ───────────────────────────────────────────────────────────────
# Enumerations
# ───────────────────────────────────────────────────────────────

## Eviction policy applied when the cache reaches capacity.
##
## - `None` keeps all entries (unbounded growth, capacity ignored).
## - `LRU` evicts the least-recently-used key (reads refresh recency).
## - `FIFO` evicts the oldest-inserted key (reads do not refresh recency).
## - `LFU` evicts the least-frequently-used key (ties break by age, oldest first).
pub enum EvictionPolicy
    None = 0,
    LRU = 1,
    FIFO = 2,
    LFU = 3
end

# ───────────────────────────────────────────────────────────────
# Data Models (Structs)
# ───────────────────────────────────────────────────────────────

## Configuration options for cache construction.
##
## ### Fields
## - `capacity`: Maximum entry count before eviction (`<= 0` means unbounded).
## - `default_ttl`: Default time-to-live in seconds (`0` means no expiry).
## - `policy`: `EvictionPolicy` variant integer.
pub struct CacheOptions
    capacity: int,
    default_ttl: int,
    policy: int
end

## Per-entry metadata holding expiry and usage counters.
##
## NOTE: All fields are statically typed. User values are NEVER stored in
## struct fields: an untyped struct field holding mixed value types
## (string + int across instances) miscompiles on some builds and corrupts
## reads globally. Values live directly in the `store` map (maps handle
## mixed `any` values correctly); only typed metadata lives here.
##
## ### Fields
## - `expires_at`: Unix epoch seconds when the entry expires (`0` = never).
## - `inserted_at`: Unix epoch seconds when the entry was written.
## - `entry_hits`: Number of successful reads served from this entry.
## - `kind`: Value kind tag for snapshots (`"s"`/`"i"`/`"f"`, `""` = unknown).
pub struct CacheMeta
    expires_at: int,
    inserted_at: int,
    entry_hits: int,
    kind: string
end

## In-memory cache container with storage, recency order, and counters.
##
## ### Fields
## - `store`: Internal key -> value map (user payloads, any type).
## - `meta`: Internal key -> `CacheMeta` map (expiry and hit counters).
## - `order`: Recency/insertion order of keys (front = eviction candidate).
## - `capacity`: Maximum entry count (`<= 0` means unbounded).
## - `default_ttl`: Default TTL in seconds applied when `set` omits `ttl`.
## - `policy`: `EvictionPolicy` variant integer.
## - `hits`: Lifetime successful reads.
## - `misses`: Lifetime failed reads (missing or expired keys).
## - `evictions`: Lifetime capacity evictions performed.
## - `evict_hook`: Capacity-eviction callback `fn(key, value)` or null.
## - `expire_hook`: Expiry callback `fn(key, value)` or null.
pub struct Cache
    store: map,
    meta: map,
    order: array,
    capacity: int,
    default_ttl: int,
    policy: int,
    hits: int,
    misses: int,
    evictions: int,
    evict_hook,
    expire_hook
end

## Point-in-time snapshot of cache utilization and efficiency.
##
## ### Fields
## - `size`: Current live entry count.
## - `capacity`: Configured maximum (`<= 0` means unbounded).
## - `hits`: Lifetime successful reads.
## - `misses`: Lifetime failed reads.
## - `evictions`: Lifetime capacity evictions.
## - `policy`: Active `EvictionPolicy` variant integer.
pub struct CacheStats
    size: int,
    capacity: int,
    hits: int,
    misses: int,
    evictions: int,
    policy: int
end

# ───────────────────────────────────────────────────────────────
# Private Helpers
# ───────────────────────────────────────────────────────────────

# Formats hits/total as a percentage string, guarding divide-by-zero.
function format_hit_rate_internal(hits: int, total: int) -> string
    if total <= 0
        return "0%"
    end
    let pct = (hits * 100) / total
    return "{pct}%"
end

# ───────────────────────────────────────────────────────────────
# Factory Constructors
# ───────────────────────────────────────────────────────────────

## Creates cache options with explicit capacity, TTL, and policy.
##
## ### Parameters
## - `capacity`: Maximum entries (`<= 0` means unbounded). Defaults to `128`.
## - `default_ttl`: Default TTL seconds (`0` = no expiry). Defaults to `0`.
## - `policy`: `EvictionPolicy` variant. Defaults to `EvictionPolicy.LRU`.
##
## ### Returns
## Initialized `CacheOptions` instance.
pub function options_new(capacity: int = 128, default_ttl: int = 0, policy: int = EvictionPolicy.LRU) -> CacheOptions
    return CacheOptions {
        capacity: capacity,
        default_ttl: default_ttl,
        policy: policy
    }
end

## Creates LRU options with the given capacity and optional default TTL.
pub function options_lru(capacity: int = 128, default_ttl: int = 0) -> CacheOptions
    return options_new(capacity, default_ttl, EvictionPolicy.LRU)
end

## Creates FIFO options with the given capacity and optional default TTL.
pub function options_fifo(capacity: int = 128, default_ttl: int = 0) -> CacheOptions
    return options_new(capacity, default_ttl, EvictionPolicy.FIFO)
end

## Creates LFU options with the given capacity and optional default TTL.
pub function options_lfu(capacity: int = 128, default_ttl: int = 0) -> CacheOptions
    return options_new(capacity, default_ttl, EvictionPolicy.LFU)
end

## Creates unbounded options (no eviction) with an optional default TTL.
pub function options_unbounded(default_ttl: int = 0) -> CacheOptions
    return options_new(0, default_ttl, EvictionPolicy.None)
end

## Creates cache metadata stamped with the current time.
##
## ### Parameters
## - `ttl`: TTL seconds (`0` = never expires, `< 0` is normalized to `0` here).
## - `kind`: Value kind tag (`"s"`/`"i"`/`"f"`, `""` = unknown/unsnapshotted).
##
## ### Returns
## Initialized `CacheMeta` instance.
pub function meta_new(ttl: int = 0, kind: string = "") -> CacheMeta
    let now = time()
    let expires = 0
    if ttl > 0
        expires = now + ttl
    end
    return CacheMeta {
        expires_at: expires,
        inserted_at: now,
        entry_hits: 0,
        kind: kind
    }
end

## Creates a cache container with explicit settings.
##
## ### Parameters
## - `capacity`: Maximum entries (`<= 0` means unbounded). Defaults to `128`.
## - `default_ttl`: Default TTL seconds. Defaults to `0` (no expiry).
## - `policy`: `EvictionPolicy` variant. Defaults to `EvictionPolicy.LRU`.
##
## ### Returns
## Empty, initialized `Cache` instance.
pub function cache_new(capacity: int = 128, default_ttl: int = 0, policy: int = EvictionPolicy.LRU) -> Cache
    return Cache {
        store: map(),
        meta: map(),
        order: [],
        capacity: capacity,
        default_ttl: default_ttl,
        policy: policy,
        hits: 0,
        misses: 0,
        evictions: 0,
        evict_hook: null,
        expire_hook: null
    }
end

## Creates a cache container from a `CacheOptions` instance.
pub function cache_with_options(opts: CacheOptions) -> Cache
    return cache_new(opts.capacity, opts.default_ttl, opts.policy)
end

## Builds a `CacheStats` snapshot record.
pub function make_stats(size: int, capacity: int, hits: int, misses: int, evictions: int, policy: int = EvictionPolicy.LRU) -> CacheStats
    return CacheStats {
        size: size,
        capacity: capacity,
        hits: hits,
        misses: misses,
        evictions: evictions,
        policy: policy
    }
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: CacheMeta
# ───────────────────────────────────────────────────────────────

## Returns 1 when this entry is expired at the current time, 0 otherwise.
##
## Entries with `expires_at == 0` never expire.
pub function CacheMeta.is_expired(self: CacheMeta) -> int
    if self.expires_at == 0
        return 0
    end
    if time() >= self.expires_at
        return 1
    end
    return 0
end

## Returns 1 when this entry is live (not expired), 0 otherwise.
pub function CacheMeta.is_alive(self: CacheMeta) -> int
    if self.is_expired() == 1
        return 0
    end
    return 1
end

## Returns remaining TTL seconds (`0` means never expires, `0` when elapsed).
pub function CacheMeta.ttl_remaining(self: CacheMeta) -> int
    if self.expires_at == 0
        return 0
    end
    let left = self.expires_at - time()
    if left < 0
        return 0
    end
    return left
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: CacheStats
# ───────────────────────────────────────────────────────────────

## Returns total read requests (`hits + misses`).
pub function CacheStats.total_requests(self: CacheStats) -> int
    return self.hits + self.misses
end

## Returns hit-rate percentage string (e.g. `"80%"`, `"0%"` when no traffic).
pub function CacheStats.hit_rate(self: CacheStats) -> string
    return format_hit_rate_internal(self.hits, self.hits + self.misses)
end

## Returns one-line human-readable summary of this snapshot.
pub function CacheStats.summary(self: CacheStats) -> string
    return "[Cache] size={self.size}, hits={self.hits}, misses={self.misses}, evictions={self.evictions}, hit_rate={self.hit_rate()}"
end

# ───────────────────────────────────────────────────────────────
# Struct Methods: Cache (introspection only; mutation lives in store/lib)
# ───────────────────────────────────────────────────────────────

## Returns current live entry count (includes expired-but-unpruned entries).
pub function Cache.len(self: Cache) -> int
    return len(self.store)
end

## Returns 1 when the cache holds no entries, 0 otherwise.
pub function Cache.is_empty(self: Cache) -> int
    if len(self.store) == 0
        return 1
    end
    return 0
end

## Returns lifetime hit-rate percentage string.
pub function Cache.hit_rate(self: Cache) -> string
    return format_hit_rate_internal(self.hits, self.hits + self.misses)
end

## Returns one-line summary of size, counters, and hit rate.
pub function Cache.summary(self: Cache) -> string
    return "[Cache] size={len(self.store)}, capacity={self.capacity}, hits={self.hits}, misses={self.misses}, evictions={self.evictions}, hit_rate={self.hit_rate()}"
end
