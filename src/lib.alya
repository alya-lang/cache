## cache Library Facade
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Serves as the primary public entry point for the cache package,
## exposing constructors, stateful Cache methods, and batch helpers.

import "./types.alya"
import "./core/store.alya"

# ───────────────────────────────────────────────────────────────
# Constructors
# ───────────────────────────────────────────────────────────────

## Creates a cache with explicit capacity, default TTL, and eviction policy.
##
## ### Parameters
## - `capacity`: Maximum entries (`<= 0` = unbounded). Defaults to `128`.
## - `default_ttl`: Default TTL seconds (`0` = no expiry). Defaults to `0`.
## - `policy`: `EvictionPolicy` variant. Defaults to `EvictionPolicy.LRU`.
##
## ### Returns
## Empty `Cache` instance.
##
## ### Examples
## ```alya
## let c = new_cache(128, 60)
## c.set("user:1", "Ada")
## ```
pub function new_cache(capacity: int = 128, default_ttl: int = 0, policy: int = EvictionPolicy.LRU) -> Cache
    return cache_new(capacity, default_ttl, policy)
end

## Creates an LRU cache with the given capacity and optional default TTL.
pub function lru_cache(capacity: int = 128, default_ttl: int = 0) -> Cache
    return cache_new(capacity, default_ttl, EvictionPolicy.LRU)
end

## Creates a FIFO cache with the given capacity and optional default TTL.
pub function fifo_cache(capacity: int = 128, default_ttl: int = 0) -> Cache
    return cache_new(capacity, default_ttl, EvictionPolicy.FIFO)
end

## Creates an unbounded cache (no eviction) with an optional default TTL.
pub function unbounded_cache(default_ttl: int = 0) -> Cache
    return cache_new(0, default_ttl, EvictionPolicy.None)
end

## Creates a cache from a `CacheOptions` instance.
pub function cache_from_options(opts: CacheOptions) -> Cache
    return cache_with_options(opts)
end

# ───────────────────────────────────────────────────────────────
# Stateful Cache Methods
# ───────────────────────────────────────────────────────────────

## Inserts or overwrites `key` with `value` and an optional TTL.
##
## `ttl < 0` uses the cache default, `ttl == 0` never expires.
pub function Cache.set(self: Cache, key, value, ttl: int = -1) -> int
    return store_set(self, key, value, ttl)
end

## Returns the value for `key`, or null on miss/expiry.
pub function Cache.get(self: Cache, key)
    return store_get(self, key)
end

## Returns the value for `key`, or `fallback` on miss/expiry.
pub function Cache.get_or(self: Cache, key, fallback)
    return store_get_or(self, key, fallback)
end

## Returns 1 when `key` exists and is live, 0 otherwise.
pub function Cache.has(self: Cache, key) -> int
    return store_has(self, key)
end

## Deletes `key`. Returns 1 when an entry was removed, 0 otherwise.
pub function Cache.delete(self: Cache, key) -> int
    return store_delete(self, key)
end

## Alias for `delete`: removes `key` and returns 1 when removed.
pub function Cache.remove(self: Cache, key) -> int
    return store_delete(self, key)
end

## Removes all entries and resets hit/miss/eviction counters.
pub function Cache.clear(self: Cache)
    store_clear(self)
end

## Returns the number of entries currently held.
pub function Cache.size(self: Cache) -> int
    return store_size(self)
end

## Returns a snapshot array of live keys (expired entries pruned first).
##
## NOTE: The snapshot loop lives in this facade frame on purpose. Building
## the result collection here (rather than forwarding through another
## struct-threading layer) keeps collection returns one hop from the caller.
pub function Cache.keys(self: Cache) -> array
    let live = []
    let snapshot = store_order_snapshot(self)
    for k in snapshot
        let key = "" + k
        if prune_key(self, key) == 1
            continue
        end
        live.push(key)
    end
    store_set_order(self, live)
    return live
end

## Removes expired entries. Returns the number of entries pruned.
##
## NOTE: The iteration loop lives in this facade frame (see `keys()`
## note). `prune_key` handles one key at a time with no loop inside.
## Each iterated key is copied (`"" + k`) before the call: keys read out
## of struct-field arrays must not be passed to struct calls directly.
pub function Cache.prune(self: Cache) -> int
    let pruned = 0
    let live = []
    let snapshot = store_order_snapshot(self)
    for k in snapshot
        let key = "" + k
        if prune_key(self, key) == 1
            pruned += 1
        else
            live.push(key)
        end
    end
    store_set_order(self, live)
    return pruned
end

## Builds a `CacheStats` snapshot of the current state.
##
## NOTE: `make_stats` takes plain integers (no struct threading), so the
## snapshot is assembled directly in this frame.
pub function Cache.stats(self: Cache) -> CacheStats
    return make_stats(len(self.store), self.capacity, self.hits, self.misses, self.evictions, self.policy)
end

## Returns remaining TTL seconds for `key` (`-1` missing/expired, `0` persist).
pub function Cache.ttl(self: Cache, key) -> int
    return store_ttl(self, key)
end

## Refreshes the TTL of a live entry. Returns 1 on success, 0 if missing.
pub function Cache.expire(self: Cache, key, ttl: int) -> int
    return store_expire(self, key, ttl)
end

## Inserts all entries from a map with a shared TTL. Returns inserted count.
##
## NOTE: Iterates `keys(values)` and loops in this frame (see `keys()` note).
pub function Cache.set_many(self: Cache, values: map, ttl: int = -1) -> int
    if values is null
        return 0
    end
    let n = 0
    for k in keys(values)
        store_set(self, k, values[k], ttl)
        n += 1
    end
    return n
end

## Reads many keys, returning a map of live key -> value pairs.
##
## NOTE: Loops in this frame (see `keys()` note).
pub function Cache.get_many(self: Cache, key_list: array) -> map
    let out = map()
    if key_list is null
        return out
    end
    for k in key_list
        let val = store_get(self, k)
        if val is not null
            out[k] = val
        end
    end
    return out
end

## Returns the value for `key`, inserting `value` first on miss/expiry.
##
## Useful as a memoize/insert-if-absent helper without closures.
pub function Cache.get_or_insert(self: Cache, key, value, ttl: int = -1)
    let current = store_get(self, key)
    if current is not null
        return current
    end
    store_set(self, key, value, ttl)
    return value
end

# ───────────────────────────────────────────────────────────────
# Standalone Facade Functions (functional style)
# ───────────────────────────────────────────────────────────────

## Functional `set` operating on an explicit cache instance.
pub function cache_set(c: Cache, key, value, ttl: int = -1) -> int
    return store_set(c, key, value, ttl)
end

## Functional `get` operating on an explicit cache instance.
pub function cache_get(c: Cache, key)
    return store_get(c, key)
end

## Functional `get_or` operating on an explicit cache instance.
pub function cache_get_or(c: Cache, key, fallback)
    return store_get_or(c, key, fallback)
end

## Functional `has` operating on an explicit cache instance.
pub function cache_has(c: Cache, key) -> int
    return store_has(c, key)
end

## Functional `delete` operating on an explicit cache instance.
pub function cache_delete(c: Cache, key) -> int
    return store_delete(c, key)
end

## Functional `clear` operating on an explicit cache instance.
pub function cache_clear(c: Cache)
    store_clear(c)
end

## Functional `size` operating on an explicit cache instance.
pub function cache_size(c: Cache) -> int
    return store_size(c)
end

## Functional `keys` operating on an explicit cache instance.
pub function cache_keys(c: Cache) -> array
    let live = []
    let snapshot = store_order_snapshot(c)
    for k in snapshot
        let key = "" + k
        if prune_key(c, key) == 1
            continue
        end
        live.push(key)
    end
    store_set_order(c, live)
    return live
end

## Functional `prune` operating on an explicit cache instance.
pub function cache_prune(c: Cache) -> int
    let pruned = 0
    let live = []
    let snapshot = store_order_snapshot(c)
    for k in snapshot
        let key = "" + k
        if prune_key(c, key) == 1
            pruned += 1
        else
            live.push(key)
        end
    end
    store_set_order(c, live)
    return pruned
end

## Functional `stats` operating on an explicit cache instance.
pub function cache_stats(c: Cache) -> CacheStats
    return make_stats(len(c.store), c.capacity, c.hits, c.misses, c.evictions, c.policy)
end

## Functional `set_many` operating on an explicit cache instance.
pub function cache_set_many(c: Cache, values: map, ttl: int = -1) -> int
    if values is null
        return 0
    end
    let n = 0
    for k in keys(values)
        store_set(c, k, values[k], ttl)
        n += 1
    end
    return n
end

## Functional `get_many` operating on an explicit cache instance.
pub function cache_get_many(c: Cache, key_list: array) -> map
    let out = map()
    if key_list is null
        return out
    end
    for k in key_list
        let val = store_get(c, k)
        if val is not null
            out[k] = val
        end
    end
    return out
end
