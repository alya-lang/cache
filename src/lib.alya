    return store_delete(c, key)
end

## Functional `clear` operating on an explicit cache instance.
pub function cache_clear(c: Cache)
    store_clear(c)
end

## Functional `size` operating on an explicit cache instance.
pub function cache_size(c: Cache) -> int
    return store_size(c)
end

## Functional `keys` operating on an explicit cache instance.
pub function cache_keys(c: Cache) -> array
    let live = []
    let snapshot = store_order_snapshot(c)
    for k in snapshot
        let key = "" + k
        if prune_key(c, key) == 1
            continue
        end
        live.push(key)
    end
    store_set_order(c, live)
    return live
end

## Functional `prune` operating on an explicit cache instance.
pub function cache_prune(c: Cache) -> int
    let pruned = 0
    let live = []
    let snapshot = store_order_snapshot(c)
    for k in snapshot
        let key = "" + k
        if prune_key(c, key) == 1
            pruned += 1
        else
            live.push(key)
        end
    end
    store_set_order(c, live)
    return pruned
end

## Functional `stats` operating on an explicit cache instance.
pub function cache_stats(c: Cache) -> CacheStats
    return make_stats(len(c.store), c.capacity, c.hits, c.misses, c.evictions, c.policy)
end

## Functional `peek` operating on an explicit cache instance.
pub function cache_peek(c: Cache, key)
    return store_peek(c, key)
end

## Functional `get_float` operating on an explicit cache instance.
pub function cache_get_float(c: Cache, key)
    return store_get_float(c, key)
end

## Functional `touch` operating on an explicit cache instance.
pub function cache_touch(c: Cache, key, ttl: int = -1) -> int
    return store_touch(c, key, ttl)
end

## Functional `set_capacity` operating on an explicit cache instance.
pub function cache_set_capacity(c: Cache, capacity: int)
    store_set_capacity(c, capacity)
end

## Functional `set_default_ttl` operating on an explicit cache instance.
pub function cache_set_default_ttl(c: Cache, default_ttl: int)
    store_set_default_ttl(c, default_ttl)
end

## Functional `delete_by_prefix` operating on an explicit cache instance.
pub function cache_delete_by_prefix(c: Cache, prefix: string) -> int
    let count = 0
    let plen = len(prefix)
    let snapshot = store_order_snapshot(c)
    for k in snapshot
        let key = "" + k
        if len(key) >= plen and key[..plen] == prefix
            if store_delete(c, key) == 1
                count += 1
            end
        end
    end
    return count
end

## Functional `get_or_insert` operating on an explicit cache instance.
pub function cache_get_or_insert(c: Cache, key, value, ttl: int = -1)
    let current = store_get(c, key)
    if current is not null
        return current
    end
    store_set(c, key, value, ttl)
    return value
end

## Functional `get_or_compute` operating on an explicit cache instance.
pub function cache_get_or_compute(c: Cache, key, producer, ttl: int = -1)
    let current = store_get(c, key)
    if current is not null
        return current
    end
    let produced = producer(key)
    store_set(c, key, produced, ttl)
    return produced
end

## Functional `set_jittered` operating on an explicit cache instance.
pub function cache_set_jittered(c: Cache, key, value, ttl: int, max_jitter: int = 0) -> int
    let spread = 0
    if max_jitter > 0 and ttl > 0
        spread = (time() + len(key) * 7919 + len(c.order) * 31) % (max_jitter + 1)
    end
    return store_set(c, key, value, ttl + spread)
end

## Functional `on_evict` operating on an explicit cache instance.
pub function cache_on_evict(c: Cache, cb)
    c.evict_hook = cb
end

## Functional `on_expire` operating on an explicit cache instance.
pub function cache_on_expire(c: Cache, cb)
    c.expire_hook = cb
end

## Functional `save` operating on an explicit cache instance.
pub function cache_save(c: Cache, path: string) -> int
    let content = snapshot_header()
    let count = 0
    let snapshot = store_order_snapshot(c)
    for k in snapshot
        let key = "" + k
        let line = snapshot_line(c, key)
        if line != ""
            content = content + "\n" + line
            count += 1
        end
    end
    fs_write(path, content)
    return count
end

## Functional `load` operating on an explicit cache instance.
pub function cache_load(c: Cache, path: string) -> int
    if fs_exists(path) == 0
        return 0
    end
    let content = fs_read(path)
    let count = 0
    for line in split(content, "\n")
        let parsed = snapshot_parse(line)
        if parsed is null
            continue
        end
        store_set(c, parsed[0], parsed[1], parsed[2], parsed[3])
        count += 1
    end
    return count
end

## Functional `set_many` operating on an explicit cache instance.
pub function cache_set_many(c: Cache, values: map, ttl: int = -1) -> int
    if values is null
        return 0
    end
    let n = 0
    for k in keys(values)
        store_set(c, k, values[k], ttl)
        n += 1
    end
    return n
end

## Functional `get_many` operating on an explicit cache instance.
pub function cache_get_many(c: Cache, key_list: array) -> map
    let out = map()
    if key_list is null
        return out
    end
    for k in key_list
        let val = store_get(c, k)
        if val is not null
            out[k] = val
        end
    end
    return out
end
