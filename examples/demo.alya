## Example usage and walkthrough for cache
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/fs"
import "../src/lib.alya" as pkg

function main()
    say "=== cache Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Basic Set / Get
    # ───────────────────────────────────────────────────────────
    say "--- 1. Basic Set / Get ---"
    let c = pkg::new_cache(128, 0)
    c.set("user:1", "Ada")
    c.set("user:2", "Grace")
    say "user:1 => " + c.get_or("user:1", "missing")
    say "user:9 => " + c.get_or("user:9", "missing")
    say "size   => " + str(c.size())
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. TTL Expiry
    # ───────────────────────────────────────────────────────────
    say "--- 2. TTL Expiry ---"
    c.set("session:token", "abc123", 3600)
    say "session ttl (s) => " + str(c.ttl("session:token"))
    say "persist ttl     => " + str(c.ttl("user:1"))
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. LRU Eviction
    # ───────────────────────────────────────────────────────────
    say "--- 3. LRU Eviction ---"
    let small = pkg::lru_cache(2, 0)
    small.set("a", 1)
    small.set("b", 2)
    small.get("a")
    small.set("c", 3)
    say "has a => " + str(small.has("a"))
    say "has b => " + str(small.has("b"))
    say "has c => " + str(small.has("c"))
    say "evictions => " + str(small.evictions)
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Batch Helpers & Memoize
    # ───────────────────────────────────────────────────────────
    say "--- 4. Batch & Memoize ---"
    let batch = pkg::new_cache(16, 0)
    batch.set_many({ "x": 1, "y": 2, "z": 3 })
    let many = batch.get_many(["x", "z", "nope"])
    say "get_many live keys => " + str(len(many))
    say "memo first  => " + str(batch.get_or_insert("memo", 99))
    say "memo second => " + str(batch.get_or_insert("memo", 100))
    say ""

    # ───────────────────────────────────────────────────────────
    # 5. FIFO + Unbounded Flavors
    # ───────────────────────────────────────────────────────────
    say "--- 5. FIFO & Unbounded ---"
    let fifo = pkg::fifo_cache(2, 0)
    fifo.set("a", 1)
    fifo.set("b", 2)
    fifo.get("a")
    fifo.set("c", 3)
    say "fifo keeps b => " + str(fifo.has("b"))
    let big = pkg::unbounded_cache()
    big.set("anything", 1)
    say "unbounded size => " + str(big.size())
    say ""

    # ───────────────────────────────────────────────────────────
    # 6. Stats & Maintenance
    # ───────────────────────────────────────────────────────────
    say "--- 6. Stats & Maintenance ---"
    say c.summary()
    say "pruned => " + str(c.prune())
    say "keys   => " + str(len(c.keys()))
    c.clear()
    say "after clear size => " + str(c.size())
    say ""

    # ───────────────────────────────────────────────────────────
    # 7. Peek, Touch & Runtime Config
    # ───────────────────────────────────────────────────────────
    say "--- 7. Peek, Touch & Config ---"
    let t = pkg::lru_cache(2, 0)
    t.set("a", 1)
    t.set("b", 2)
    t.touch("a")
    t.set("c", 3)
    say "has a after touch => " + str(t.has("a"))
    say "peek b => " + str(t.peek("b"))
    t.set_capacity(1)
    say "size after shrink => " + str(t.size())
    t.set_default_ttl(60)
    t.set("fresh", "x")
    say "fresh ttl => " + str(t.ttl("fresh"))
    say "deleted by prefix => " + str(t.delete_by_prefix("fr"))
    say ""

    # ───────────────────────────────────────────────────────────
    # 8. LFU, Hooks, Compute & Snapshot
    # ───────────────────────────────────────────────────────────
    say "--- 8. LFU, Hooks, Compute & Snapshot ---"
    let f = pkg::lfu_cache(2, 0)
    f.on_evict(evicted_note)
    f.set("hot", "H")
    f.set("cold", "C")
    f.get("hot")
    f.get("hot")
    f.set("new", "N")
    say "lfu keeps hot => " + str(f.has("hot"))
    say "evict notes => " + str(len(evicted_log))

    let m = pkg::new_cache(16, 0)
    say "computed => " + m.get_or_compute("k", make_value)
    m.set_jittered("j", "v", 100, 20)
    say "jittered ttl => " + str(m.ttl("j"))
    m.set_str("who", "Ada")
    m.set_int("n", 7)
    say "saved => " + str(m.save("demo-snap.tmp")) + " entries"
    let m2 = pkg::new_cache(16, 0)
    say "loaded => " + str(m2.load("demo-snap.tmp")) + " entries"
    say "who => " + m2.get("who")
    say ""
    fs_remove("demo-snap.tmp")

    say "Done!"
end

let evicted_log = []

function evicted_note(key, _value)
    evicted_log.push(key)
    return 1
end

function make_value(key)
    return "made:" + key
end

main()
