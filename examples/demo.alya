## Example usage and walkthrough for cache
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as pkg

function main()
    say "=== cache Package Showcase ==="
    say ""

    # ───────────────────────────────────────────────────────────
    # 1. Basic Set / Get
    # ───────────────────────────────────────────────────────────
    say "--- 1. Basic Set / Get ---"
    let c = pkg::new_cache(128, 0)
    c.set("user:1", "Ada")
    c.set("user:2", "Grace")
    say "user:1 => " + c.get_or("user:1", "missing")
    say "user:9 => " + c.get_or("user:9", "missing")
    say "size   => " + str(c.size())
    say ""

    # ───────────────────────────────────────────────────────────
    # 2. TTL Expiry
    # ───────────────────────────────────────────────────────────
    say "--- 2. TTL Expiry ---"
    c.set("session:token", "abc123", 3600)
    say "session ttl (s) => " + str(c.ttl("session:token"))
    say "persist ttl     => " + str(c.ttl("user:1"))
    say ""

    # ───────────────────────────────────────────────────────────
    # 3. LRU Eviction
    # ───────────────────────────────────────────────────────────
    say "--- 3. LRU Eviction ---"
    let small = pkg::lru_cache(2, 0)
    small.set("a", 1)
    small.set("b", 2)
    small.get("a")
    small.set("c", 3)
    say "has a => " + str(small.has("a"))
    say "has b => " + str(small.has("b"))
    say "has c => " + str(small.has("c"))
    say "evictions => " + str(small.evictions)
    say ""

    # ───────────────────────────────────────────────────────────
    # 4. Batch Helpers & Memoize
    # ───────────────────────────────────────────────────────────
    say "--- 4. Batch & Memoize ---"
    let batch = pkg::new_cache(16, 0)
    batch.set_many({ "x": 1, "y": 2, "z": 3 })
    let many = batch.get_many(["x", "z", "nope"])
    say "get_many live keys => " + str(len(many))
    say "memo first  => " + str(batch.get_or_insert("memo", 99))
    say "memo second => " + str(batch.get_or_insert("memo", 100))
    say ""

    # ───────────────────────────────────────────────────────────
    # 5. FIFO + Unbounded Flavors
    # ───────────────────────────────────────────────────────────
    say "--- 5. FIFO & Unbounded ---"
    let fifo = pkg::fifo_cache(2, 0)
    fifo.set("a", 1)
    fifo.set("b", 2)
    fifo.get("a")
    fifo.set("c", 3)
    say "fifo keeps b => " + str(fifo.has("b"))
    let big = pkg::unbounded_cache()
    big.set("anything", 1)
    say "unbounded size => " + str(big.size())
    say ""

    # ───────────────────────────────────────────────────────────
    # 6. Stats & Maintenance
    # ───────────────────────────────────────────────────────────
    say "--- 6. Stats & Maintenance ---"
    say c.summary()
    say "pruned => " + str(c.prune())
    say "keys   => " + str(len(c.keys()))
    c.clear()
    say "after clear size => " + str(c.size())
    say ""

    say "Done!"
end

main()
