## Benchmark suite for cache
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/test"
import "../src/lib.alya" as pkg

function main()
    let runner = bench_runner("cache Micro-Benchmarks")

    # Bench 1: set() throughput — 20k inserts
    let c1 = pkg::unbounded_cache()
    bench_start(runner, 20000)
    let i = 0
    while i < 20000
        c1.set("k{i}", i)
        i += 1
    end
    bench_stop(runner, "set() 20k inserts")

    # Bench 2: get() hit throughput — 50k reads
    bench_start(runner, 50000)
    let j = 0
    while j < 50000
        c1.get("k1")
        j += 1
    end
    bench_stop(runner, "get() hit 50k reads")

    # Bench 3: get() miss throughput — 20k reads
    bench_start(runner, 20000)
    let k = 0
    while k < 20000
        c1.get("absent-{k}")
        k += 1
    end
    bench_stop(runner, "get() miss 20k reads")

    # Bench 4: LRU set with eviction — 10k inserts at capacity 128
    let c4 = pkg::lru_cache(128, 0)
    bench_start(runner, 10000)
    let m = 0
    while m < 10000
        c4.set("key-{m}", m)
        m += 1
    end
    bench_stop(runner, "lru set() with eviction 10k inserts")

    # Bench 5: set_many batch — 2k batches of 10 entries
    let c5 = pkg::unbounded_cache()
    let bulk = { "a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6, "g": 7, "h": 8, "i": 9, "j": 10 }
    bench_start(runner, 2000)
    let n = 0
    while n < 2000
        c5.set_many(bulk)
        n += 1
    end
    bench_stop(runner, "set_many() 10-item batch 2k calls")

    # Bench 6: stats snapshot — 20k snapshots
    bench_start(runner, 20000)
    let s = 0
    while s < 20000
        c1.stats()
        s += 1
    end
    bench_stop(runner, "stats() 20k snapshots")

    bench_summary(runner)
end

main()
